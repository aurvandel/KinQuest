services:
  kinquest-app:
    ports: !reset []
    expose:
      - "${HTTP_PORT:-3000}"
    environment:
      - SERVER_PROTOCOL=http
      - SSL_CERT_PATH=
      - SSL_KEY_PATH=

  nginx_proxy:
    image: nginx:alpine
    container_name: nginx_proxy
    restart: always
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./nginx/certs:/etc/nginx/certs:ro
    depends_on:
      - kinquest-app
