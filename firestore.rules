rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (default deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validate User object
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'username', 'score', 'completedCount', 'createdAt']) &&
             data.id is string &&
             data.username is string && data.username.size() <= 50 &&
             data.score is int && data.score >= 0 &&
             data.completedCount is int && data.completedCount >= 0;
    }

    // Validate Submission object
    function isValidSubmission(data) {
      return data.keys().hasAll(['id', 'userId', 'username', 'itemId', 'imageUrl', 'status', 'createdAt']) &&
             data.id is string &&
             data.userId is string &&
             data.username is string &&
             data.itemId is string &&
             data.imageUrl is string && data.imageUrl.size() <= 2000000 &&
             data.status is string && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected');
    }

    // Match collections
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && 
                    isValidId(userId) && 
                    isValidUser(request.resource.data) && 
                    request.resource.data.score == 0 && 
                    request.resource.data.completedCount == 0;
      allow update: if isOwner(userId) && 
                    isValidUser(request.resource.data);
    }

    match /submissions/{submissionId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || true); 
      // Anyone signed in can view list, but we enforce query matches or allow everyone to see photos for feeds
      
      allow create: if isSignedIn() && 
                    isValidId(submissionId) &&
                    request.resource.data.userId == request.auth.uid && 
                    isValidSubmission(request.resource.data) &&
                    request.resource.data.status == 'pending';
                    
      allow update: if isSignedIn() && 
                    isValidId(submissionId) &&
                    resource.data.userId == request.auth.uid && 
                    isValidSubmission(request.resource.data);
                    
      allow delete: if isSignedIn() && 
                    isValidId(submissionId) &&
                    resource.data.userId == request.auth.uid;
    }

    match /items/{itemId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if false; 
    }
  }
}