# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OLLAMA SLIDESHOW GENERATION
# Used for slideshow script and narration generation.
# Example local URL: http://localhost:11434
# Example remote URL: https://ollama.my-network.internal
OLLAMA_SERVER_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"
OLLAMA_API_KEY=""
# Timeout for /api/generate script requests. Lower values fail fast to offline fallback.
OLLAMA_REQUEST_TIMEOUT_MS="15000"
# Script generation mode: direct | offload_if_presenton | disabled
OLLAMA_SCRIPT_MODE="offload_if_presenton"

# PRESENTON SLIDESHOW GENERATION (OPTIONAL)
# If provided, KinQuest attempts Presenton MP4 generation first,
# then falls back to local FFmpeg rendering if Presenton is unavailable.
PRESENTON_SERVER_URL=""
PRESENTON_API_KEY=""
PRESENTON_USERNAME=""
PRESENTON_PASSWORD=""
# Auth mode: auto | none | jwt | basic | api_key
# For many local self-hosted setups, use `basic` with PRESENTON_USERNAME/PRESENTON_PASSWORD.
# If your local instance is open/no-auth, use `none`.
PRESENTON_AUTH_MODE="auto"
# Login path used when PRESENTON_AUTH_MODE=jwt (or auto chooses JWT)
PRESENTON_LOGIN_PATH="/api/v1/auth/jwt/login"
# Generation endpoint path on Presenton server.
# Local self-hosted default from docs:
PRESENTON_GENERATE_PATH="/api/v1/ppt/presentation/generate"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SERVER PROTOCOL MODE
# Options: auto | http | https | both
# auto: uses HTTPS when SSL cert/key are configured, otherwise HTTP
SERVER_PROTOCOL="auto"
HTTP_PORT="3000"
HTTPS_PORT="3443"
# Tile fetch timeout (ms) for offline fail-fast behavior
TILE_UPSTREAM_TIMEOUT_MS="1000"

# HTTPS/SSL CONFIGURATION
# Set these paths to enable HTTPS directly in the Node server
SSL_CERT_PATH="/etc/ssl/certs/your-cert.crt"
SSL_KEY_PATH="/etc/ssl/private/your-key.key"
# Optional CA chain bundle if your cert requires it
# SSL_CA_PATH="/etc/ssl/certs/ca-certificates.crt"

# SUPABASE CLIENT CREDENTIALS
# Required if you want to store game metrics, users, and submissions persistently in Supabase
# If blank, WilderHunt will automatically fall back to live file-based db.json storage.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# ADMIN PASSWORD
# Default admin password for accessing admin panel (login with username 'admin')
ADMIN_PASSWORD="admin1234"

# IMAGE UPLOAD CONFIGURATION
# Host path where the uploads volume will be mounted (relative to docker-compose.yml location)
UPLOADS_HOST_PATH="./uploads"

# POSTGRESQL DATABASE CREDENTIALS
POSTGRES_DB="postgres"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres-local-development-password-must-be-secure"

# POSTGREST JWT SECRET
PGRST_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters-long"

# UMAMI ANALYTICS & SESSION REPLAY
# Enable/disable Umami tracking and replay features
VITE_UMAMI_TRACKING_ENABLED=false
VITE_UMAMI_REPLAY_ENABLED=false
# Enable/disable performance metrics tracking (Web Vitals, API calls, page load)
VITE_UMAMI_PERFORMANCE_ENABLED=false
# Umami server URL and website ID (required if tracking/replay enabled)
VITE_UMAMI_SCRIPT_URL=""
VITE_UMAMI_WEBSITE_ID=""
# Umami script names
VITE_UMAMI_TRACKING_SCRIPT="umami.js"
VITE_UMAMI_REPLAY_SCRIPT="recorder.js"
# Replay configuration
VITE_UMAMI_SAMPLE_RATE="0.15"
VITE_UMAMI_MASK_LEVEL="moderate"
VITE_UMAMI_MAX_DURATION="300000"