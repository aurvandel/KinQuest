{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.16"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:k6:smoke": "k6 run k6-tests/player-behavior.js --vus 5 --duration 1m",
    "test:k6:player": "k6 run k6-tests/player-behavior.js --vus 50 --duration 5m",
    "test:k6:spike": "k6 run k6-tests/spike-load.js",
    "test:k6:endurance": "k6 run k6-tests/endurance.js --vus 20 --duration 10m",
    "test:k6:admin": "k6 run k6-tests/admin-operations.js -e ADMIN_PASSWORD=password",
    "test:k6:chat": "k6 run k6-tests/chat-load.js",
    "test:k6:all": "bash k6-tests/run-tests.sh all",
    "test:k6:runner": "bash k6-tests/run-tests.sh",
    "test:k6:cleanup": "bash k6-tests/cleanup.sh",
    "test:k6:cleanup-full": "bash k6-tests/cleanup.sh full"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@lucide/lab": "^0.1.2",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.21",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-qr-code": "^2.2.0",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "sharp": "^0.34.5",
    "supabase": "^2.104.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
